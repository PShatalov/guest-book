# Copy to .env at the repository root for Docker Compose:
#   cp compose.env.example .env

POSTGRES_USER=guestbook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=guestbook
POSTGRES_PORT=5432

API_PORT=3001

# API auth (required for sign-up/sign-in)
SESSION_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000
# Docker Compose sets SESSION_COOKIE_SECURE=false for local HTTP (see docker-compose.yml)
