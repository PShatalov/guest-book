# Copy to apps/e2e/.env for local Playwright runs.
# compose.test.env.example at the repo root supplies default POSTGRES_* for tests.

E2E_WEB_HOST=localhost
E2E_API_HOST=localhost

# Dedicated E2E ports (default 3010/3011 — leave unset to auto-pick a free port)
E2E_WEB_PORT=3010
E2E_API_PORT=3011

# Never reuse dev on 3000/3001 unless you also point the API at the test DB
E2E_REUSE_SERVERS=false

# Test Postgres (docker-compose.test.yml, port 5433)
POSTGRES_USER=guestbook_test
POSTGRES_PASSWORD=test
POSTGRES_DB=guestbook_test
POSTGRES_PORT=5433
POSTGRES_HOST=127.0.0.1
E2E_DATABASE_URL=postgresql://guestbook_test:test@127.0.0.1:5433/guestbook_test
E2E_SESSION_SECRET=test-session-secret-for-e2e-only-not-for-production

# Do not set DATABASE_URL (dev leak) or E2E_BASE_URL (derived from E2E_WEB_PORT).

# E2E_EXTERNAL_SERVERS=1
# E2E_REUSE_SERVERS=true
