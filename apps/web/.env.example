# Same-origin proxy via Next.js rewrites (recommended for local dev + cookie sessions)
NEXT_PUBLIC_API_URL=/api
# Direct API URL (requires CORS_ORIGIN=http://localhost:3000 on the API)
# NEXT_PUBLIC_API_URL=http://localhost:3001

# OpenTelemetry (Next.js instrumentation.ts; disabled by default in tests)
# OTEL_SERVICE_NAME=guest-book-web
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SDK_DISABLED=true
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
