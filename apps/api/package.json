{
  "name": "@guest-book/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "predev": "pnpm run db:migrate",
    "dev": "nest start --watch",
    "start": "nest start",
    "prestart:dev": "pnpm run db:migrate",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:e2e:api": "jest --selectProjects e2e-db --forceExit --runInBand",
    "test:e2e:http": "jest test/health.e2e-spec.ts",
    "test:db:setup": "ts-node test/support/run-db-setup.ts",
    "test:db:teardown": "ts-node test/support/run-db-teardown.ts",
    "test:watch": "jest --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/common": "11.1.21",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.21",
    "@nestjs/platform-express": "11.1.21",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/throttler": "6.5.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.75.0",
    "@opentelemetry/sdk-node": "0.217.0",
    "argon2": "0.43.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "connect-pg-simple": "10.0.0",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.2",
    "express-session": "1.18.1",
    "helmet": "8.0.0",
    "hpp": "0.2.3",
    "nestjs-pino": "4.6.1",
    "pg": "8.20.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@guest-book/eslint-config": "workspace:*",
    "@guest-book/typescript-config": "workspace:*",
    "@nestjs/cli": "11.0.21",
    "@nestjs/testing": "11.1.21",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.3",
    "@types/express-session": "1.18.1",
    "@types/hpp": "0.2.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.29",
    "@types/pg": "8.15.4",
    "@types/supertest": "6.0.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.18.0",
    "jest": "29.7.0",
    "pino-pretty": "13.1.3",
    "source-map-support": "0.5.21",
    "supertest": "7.1.1",
    "ts-jest": "29.3.4",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "rootDir": ".",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "testMatch": [
          "<rootDir>/src/**/*.spec.ts"
        ],
        "transform": {
          "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
          "src/**/*.(t|j)s"
        ],
        "coverageDirectory": "coverage",
        "testEnvironment": "node",
        "setupFiles": [
          "<rootDir>/test/jest.env-setup.ts"
        ],
        "moduleNameMapper": {
          "^src/(.*)$": "<rootDir>/src/$1"
        }
      },
      {
        "displayName": "e2e-db",
        "rootDir": ".",
        "maxWorkers": 1,
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "testMatch": [
          "<rootDir>/test/auth.e2e-spec.ts",
          "<rootDir>/test/health.e2e-spec.ts",
          "<rootDir>/test/messages.e2e-spec.ts",
          "<rootDir>/test/users.e2e-spec.ts",
          "<rootDir>/test/security.e2e-spec.ts",
          "<rootDir>/test/support/test-database-harness.integration.spec.ts"
        ],
        "globalSetup": "<rootDir>/test/global-setup.ts",
        "globalTeardown": "<rootDir>/test/global-teardown.ts",
        "transform": {
          "^.+\\.(t|j)s$": "ts-jest"
        },
        "testEnvironment": "node",
        "setupFiles": [
          "<rootDir>/test/jest.env-setup.ts"
        ],
        "moduleNameMapper": {
          "^src/(.*)$": "<rootDir>/src/$1"
        }
      }
    ]
  }
}
