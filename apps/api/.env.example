PORT=3001
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=guestbook.sid
# Set to true only behind HTTPS (Docker Compose sets false for local HTTP)
# SESSION_COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000
# Rate limiting (in-app; milliseconds for TTL)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
# Set true when the API runs behind a reverse proxy (uses X-Forwarded-For for throttling)
TRUST_PROXY=false
# Local dev (host Postgres)
DATABASE_URL=postgresql://guestbook:change-me@localhost:5432/guestbook
# Docker Compose (service hostname `postgres`) — see compose.env.example at repo root
# DATABASE_URL=postgresql://guestbook:change-me@postgres:5432/guestbook

# OpenTelemetry (traces via OTLP; disabled by default in tests)
# OTEL_SERVICE_NAME=guest-book-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SDK_DISABLED=true
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_NODE_DISABLED_INSTRUMENTATIONS=fs,dns,net
# Pino logs include trace_id/span_id when OTel is enabled (grep Tilt "api" logs; not shown in Jaeger UI)
