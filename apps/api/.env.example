PORT=3001
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=guestbook.sid
# Set to true only behind HTTPS (Docker Compose sets false for local HTTP)
# SESSION_COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000
# Rate limiting (in-app; milliseconds for TTL)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
# Set true when the API runs behind a reverse proxy (uses X-Forwarded-For for throttling)
TRUST_PROXY=false
# Local dev (host Postgres)
DATABASE_URL=postgresql://guestbook:change-me@localhost:5432/guestbook
# Docker Compose (service hostname `postgres`) — see compose.env.example at repo root
# DATABASE_URL=postgresql://guestbook:change-me@postgres:5432/guestbook
