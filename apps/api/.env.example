PORT=3001
NODE_ENV=development
SESSION_SECRET=local-development-session-secret-not-for-production
SESSION_COOKIE_NAME=guestbook.sid
SESSION_COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
TRUST_PROXY=false

DATABASE_URL=postgresql://guestbook:guestbook@localhost:5432/guestbook

OTEL_SERVICE_NAME=guest-book-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SDK_DISABLED=true
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_NODE_DISABLED_INSTRUMENTATIONS=fs,dns,net
